# ====================================================================
# Glovix AI Builder configuration
# ====================================================================
# The Glovix builder talks to an OpenAI-compatible chat-completions API
# through the server-side proxy at app/api/ai/chat. Keep the API key on the
# server (AI_API_KEY) so it is never shipped to the browser.

# --- Required (server-side, used by /api/ai/chat) ---
# Full OpenAI-compatible chat-completions endpoint.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Secret API key injected by the proxy as the Authorization bearer token.
AI_API_KEY=your_api_key_here

# --- Required (client-side, inlined into the bundle) ---
# Model id sent in the chat-completion request body.
NEXT_PUBLIC_AI_MODEL=gpt-4o

# --- Optional ---
# If set, the client sends this key as the Authorization header instead of
# relying on the server AI_API_KEY. Leave empty for the secure server-side flow.
NEXT_PUBLIC_AI_API_KEY=
# Tavily API key enabling the in-app AI web-search tool (called client-side).
NEXT_PUBLIC_TAVILY_API_KEY=
# Legacy provider key referenced by the chat UI (optional).
NEXT_PUBLIC_CANOPYWAVE_API_KEY=
