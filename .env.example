# ====================================================================
# Glovix AI Builder — powered by Google Gemini on Vertex AI & DeepSeek
# ====================================================================
# The Glovix builder runs on Gemini or DeepSeek via the server-side route at
# app/api/ai/chat. Credentials stay on the server; no API key is shipped to
# the browser.
#
# Models starting with "deepseek" are routed to DeepSeek; everything else
# defaults to Gemini on Vertex AI.

# --- DeepSeek (OpenAI-compatible) ---
# API key for api.deepseek.com. DeepSeek speaks the OpenAI protocol natively,
# so no message conversion is needed.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional model override (default: deepseek-chat). Valid values:
#   deepseek-chat  (DeepSeek V3)
#   deepseek-reasoner (DeepSeek R1)
DEEPSEEK_MODEL=deepseek-chat

# --- Option A: Full Vertex AI (recommended) ---
# Uses Application Default Credentials (ADC). Set your GCP project and,
# optionally, a location (defaults to the "global" endpoint).
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=global

# --- Option B: API key (Vertex express / Gemini Developer API) ---
# Use instead of (or alongside) Option A if you don't have ADC set up.
GOOGLE_AIAGENT_API=your_gemini_api_key_here

# --- Optional ---
# Model id (defaults to gemini-3.5-flash).
GOOGLE_AIAGENT_MODEL=gemini-3.5-flash
# Set to "false" to force the Gemini Developer API instead of Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=true

# Tavily API key enabling the in-app AI web-search tool (called client-side).
NEXT_PUBLIC_TAVILY_API_KEY=


# ====================================================================
# Deploy VM (VPS) — where generated sites are built and served
# ====================================================================
# The admin "Deployer" setuper and the per-project deploy path both SSH into
# this VM as root. Either naming scheme works; VPS_* and VPS_SSH_* are accepted
# interchangeably so the setuper and the deploy pipeline target the same box.
VPS_HOST=your.vps.ip.or.host
VPS_USERNAME=root
VPS_ROOT_PSW=your_vps_root_password
# Optional aliases (used by the admin setuper if the VPS_* vars are unset):
# VPS_SSH_HOST=your.vps.ip.or.host
# VPS_SSH_ROOT_PASSWORD=your_vps_root_password
VPS_SSH_PORT=22

# Base domain that projects are published under: <project>.<SYCORD_BASE_DOMAIN>
SYCORD_BASE_DOMAIN=sycord.site

# Optional: token shared with the standalone vm-runner API (port 5050).
# VPS_RUNNER_TOKEN=
# VPS_SERVER_URL=http://127.0.0.1:5050

# ====================================================================
# Cloudflare — API-managed Tunnel + wildcard DNS (no browser login)
# ====================================================================
# The setuper creates one remotely-managed tunnel via the Cloudflare API,
# points *.<SYCORD_BASE_DOMAIN> at it, and runs cloudflared on the VM with the
# returned run token. This fully replaces the old interactive
# `cloudflared tunnel login` flow.
#
# CLOUDFLARE_API_KEY must be an API Token (sent as a Bearer token) with:
#   - Account » Cloudflare Tunnel » Edit
#   - Zone    » DNS » Edit
CLOUDFLARE_API_KEY=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# Optional: only set these if you use a legacy Global API Key instead of a token.
# CLOUDFLARE_API_EMAIL=you@example.com
# Optional: override the tunnel name (default: sycord-deployer).
# CLOUDFLARE_TUNNEL_NAME=sycord-deployer


# ====================================================================
# Syte Workspace API — full command + file access (recommended)
# ====================================================================
# Syra uses the Syte Deployment API for live workspace commands, typecheck,
# builds, and deploys. Docs: https://sycord.site/api/  |  ai.json
#
# Create a token in the Syte GUI or POST /api/tokens — prefix syte_
# Auth header: X-API-Key: syte_...  (same value works as Bearer token)
#
DEPLOYER_API_URL=https://sycord.site
DEPLOYER_API_KEY=syte_your_token_here

# ====================================================================
# Coolify — legacy/alternative deployment platform
# ====================================================================
# Used only when DEPLOYER_API_URL is NOT sycord.site (self-hosted Coolify).
# DEPLOYER_API_URL=https://coolify.your-domain.com
# DEPLOYER_API_KEY=your_coolify_api_token
# DEPLOYER_SERVER_UUID=
# DEPLOYER_PROJECT_UUID=
# DEPLOYER_GITHUB_APP_UUID=

# Legacy Dokploy vars (deprecated)
# DOKPLOY_API_URL=https://sycord.site/api
# DOKPLOY_API_KEY=

# ====================================================================
# GitHub — used by the save() tool to push project source before deploy
# ====================================================================
# A token + owner with repo-create permissions. Falls back to per-project
# tokens stored on the user document when these are unset.
GITHUB_API_TOKEN=your_github_token
GITHUB_OWNER=your_github_username_or_org
